Grammar

Rule 0     S' -> gramatica
Rule 1     gramatica -> programa .
Rule 2     programa -> cabecalho corpo
Rule 3     cabecalho -> titulo declaracao_subprogramas declaracoes_variaveis
Rule 4     titulo -> PROGRAM ID ;
Rule 5     declaracao_subprogramas -> declaracao_subprogramas procedure_declaration
Rule 6     declaracao_subprogramas -> declaracao_subprogramas function_declaration
Rule 7     declaracao_subprogramas -> empty
Rule 8     procedure_declaration -> PROCEDURE ID ; bloco_subprograma ;
Rule 9     procedure_declaration -> PROCEDURE ID ( parametros ) ; bloco_subprograma ;
Rule 10    function_declaration -> FUNCTION ID : tipo ; bloco_subprograma ;
Rule 11    function_declaration -> FUNCTION ID ( parametros ) : tipo ; bloco_subprograma ;
Rule 12    bloco_subprograma -> declaracoes_variaveis corpo
Rule 13    parametros -> lista_parametros
Rule 14    parametros -> empty
Rule 15    lista_parametros -> lista_id : tipo
Rule 16    lista_parametros -> lista_id : tipo ; lista_parametros
Rule 17    declaracoes_variaveis -> VAR declaracoes
Rule 18    declaracoes_variaveis -> empty
Rule 19    declaracoes -> declaracao
Rule 20    declaracoes -> declaracao declaracoes
Rule 21    declaracao -> lista_id : tipo ;
Rule 22    lista_id -> ID
Rule 23    lista_id -> lista_id , ID
Rule 24    tipo -> INTEGER
Rule 25    tipo -> REAL
Rule 26    tipo -> BOOLEAN
Rule 27    tipo -> CHAR
Rule 28    tipo -> STRING
Rule 29    tipo -> tipo_array
Rule 30    tipo_array -> ARRAY [ NUMBER RANGE NUMBER ] OF tipo
Rule 31    corpo -> BEGIN lista_instrucoes END
Rule 32    lista_instrucoes -> instrucao
Rule 33    lista_instrucoes -> lista_instrucoes ; instrucao
Rule 34    instrucao -> atribuicao
Rule 35    instrucao -> leitura
Rule 36    instrucao -> escrita
Rule 37    instrucao -> if_statement
Rule 38    instrucao -> while_statement
Rule 39    instrucao -> for_statement
Rule 40    instrucao -> chamada_procedimento
Rule 41    instrucao -> bloco
Rule 42    instrucao -> empty
Rule 43    bloco -> BEGIN lista_instrucoes END
Rule 44    atribuicao -> variavel ASSIGN expressao
Rule 45    chamada_procedimento -> ID ( lista_expressao )
Rule 46    chamada_procedimento -> ID
Rule 47    leitura -> READ ( lista_variaveis )
Rule 48    leitura -> READLN ( lista_variaveis )
Rule 49    leitura -> READLN
Rule 50    escrita -> WRITE ( lista_expressao )
Rule 51    escrita -> WRITELN ( lista_expressao )
Rule 52    escrita -> WRITELN
Rule 53    lista_variaveis -> variavel
Rule 54    lista_variaveis -> lista_variaveis , variavel
Rule 55    if_statement -> IF expressao THEN instrucao
Rule 56    if_statement -> IF expressao THEN instrucao ELSE instrucao
Rule 57    while_statement -> WHILE expressao DO instrucao
Rule 58    for_statement -> FOR ID ASSIGN expressao TO expressao DO instrucao
Rule 59    for_statement -> FOR ID ASSIGN expressao DOWNTO expressao DO instrucao
Rule 60    lista_expressao -> expressao
Rule 61    lista_expressao -> lista_expressao , expressao
Rule 62    expressao -> expressao_logica
Rule 63    expressao_logica -> expressao_logica OR expressao_relacional
Rule 64    expressao_logica -> expressao_logica AND expressao_relacional
Rule 65    expressao_logica -> expressao_relacional
Rule 66    expressao_relacional -> expressao_aritmetica operador_relacional expressao_aritmetica
Rule 67    expressao_relacional -> expressao_aritmetica
Rule 68    operador_relacional -> EQUALS
Rule 69    operador_relacional -> NOT_EQUALS
Rule 70    operador_relacional -> LESS_THAN
Rule 71    operador_relacional -> LESS_THAN_OR_EQUAL_TO
Rule 72    operador_relacional -> GREATER_THAN
Rule 73    operador_relacional -> GREATER_THAN_OR_EQUAL_TO
Rule 74    expressao_aritmetica -> expressao_aritmetica + termo
Rule 75    expressao_aritmetica -> expressao_aritmetica - termo
Rule 76    expressao_aritmetica -> termo
Rule 77    termo -> termo * fator
Rule 78    termo -> termo / fator
Rule 79    termo -> termo DIV fator
Rule 80    termo -> termo MOD fator
Rule 81    termo -> fator
Rule 82    fator -> NUMBER
Rule 83    fator -> REAL_NUMBER
Rule 84    fator -> STRING_LITERAL
Rule 85    fator -> TRUE
Rule 86    fator -> FALSE
Rule 87    fator -> variavel
Rule 88    fator -> chamada_funcao
Rule 89    fator -> ( expressao )
Rule 90    fator -> NOT fator
Rule 91    fator -> - fator
Rule 92    fator -> + fator
Rule 93    variavel -> ID
Rule 94    variavel -> ID [ expressao ]
Rule 95    chamada_funcao -> ID ( lista_expressao )
Rule 96    chamada_funcao -> LENGTH ( expressao )
Rule 97    empty -> <empty>

